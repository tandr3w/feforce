WIDTH=48;
DEPTH=256;

ADDRESS_RADIX=UNS;
DATA_RADIX=HEX;

CONTENT BEGIN
    0 : FF00FF00FF00;  -- (-1,-1,-1)
    1 : 0100FF00FF00;  -- ( 1,-1,-1)
    2 : 01000100FF00;  -- ( 1, 1,-1)
    3 : FF000100FF00;  -- (-1, 1,-1)

    4 : FF00FF000100;  -- (-1,-1, 1)
    5 : 0100FF000100;  -- ( 1,-1, 1)
    6 : 010001000100;  -- ( 1, 1, 1)
    7 : FF0001000100;  -- (-1, 1, 1)

    [8..255] : 0;
END;